#include <bits/stdc++.h>
using namespace std;

int ops = 0;
int maxdepth = 0;

void complexRec(int n, int depth) {
    maxdepth = max(maxdepth, depth);
    if (n <= 2)
        return;

    int p = n;
    while (p > 0) {
        vector<int> temp(n);
        for (int i = 0; i < n; i++) {
            temp[i] = i ^ p;
            ops++;
        }
        p >>= 1;
    }

    vector<int> small(n);
    for (int i = 0; i < n; i++) {
        small[i] = i * i;
        ops++;
    }

    reverse(small.begin(), small.end());

    complexRec(n / 2, depth + 1);
    complexRec(n / 2, depth + 1);
    complexRec(n / 2, depth + 1);
}

int main() {
    int n = 5;
    complexRec(n, 1);
    cout << ops << endl;
    cout << maxdepth << endl;
    return 0;
}
// Recursion depth: Θ(log n)
// Time complexity: Θ(n^{log₂ 3})
// Reccurance Relation: T(n/2) = 3T(n/2) + nlog(n)
